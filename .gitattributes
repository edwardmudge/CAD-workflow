# check_docs.py compares CLAUDE.md byte-for-byte against a canonical LF string.
# Without this, a Windows checkout with core.autocrlf=true fails the pointer
# check with a message that explains nothing. The check normalises line endings
# too; this is the belt to that pair of braces.
* text=auto eol=lf

# SolidWorks reads its linked equations file on Windows; the generator writes
# CRLF and compares bytes, so the checkout must be CRLF too.
cad/equations.txt text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.obj binary

# Git LFS: native CAD and exchange files. Bracket globs because SolidWorks
# writes both .SLDPRT and .sldprt, and attribute patterns are case-sensitive.
# No `lockable` yet: add it when a second person joins (see SETUP.md).
*.[Ss][Ll][Dd][Pp][Rr][Tt] filter=lfs diff=lfs merge=lfs -text
*.[Ss][Ll][Dd][Aa][Ss][Mm] filter=lfs diff=lfs merge=lfs -text
*.[Ss][Ll][Dd][Dd][Rr][Ww] filter=lfs diff=lfs merge=lfs -text
*.[Ss][Tt][Ee][Pp] filter=lfs diff=lfs merge=lfs -text
*.[Ss][Tt][Pp] filter=lfs diff=lfs merge=lfs -text
*.[Ss][Tt][Ll] filter=lfs diff=lfs merge=lfs -text
